{
  "mcpServers": {
    "aem-guides-dataset-studio": {
      "command": "C:\\path\\to\\aem-guides-mcp-client\\.venv\\Scripts\\python.exe",
      "args": ["C:\\path\\to\\aem-guides-mcp-client\\server.py"],
      "cwd": "C:\\path\\to\\aem-guides-mcp-client",
      "env": {
        "AEM_STUDIO_URL": "https://your-team-service.example",
        "AEM_STUDIO_TOKEN": "REPLACE_WITH_PERSONAL_TOKEN",
        "AEM_STUDIO_ALLOW_INSECURE_HTTP": "false",
        "AEM_STUDIO_TIMEOUT_SECONDS": "300",
        "PYTHONUTF8": "1"
      }
    }
  }
}
