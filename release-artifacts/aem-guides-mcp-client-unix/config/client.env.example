AEM_STUDIO_URL=https://your-team-service.example
# Obtain a personal identity token from your service administrator; never commit it.
AEM_STUDIO_TOKEN=REPLACE_WITH_PERSONAL_TOKEN
# Prefer HTTPS. Set true only when explicitly accepting plaintext non-loopback dev/VPN transport.
AEM_STUDIO_ALLOW_INSECURE_HTTP=false
AEM_STUDIO_TIMEOUT_SECONDS=300
PYTHONUTF8=1
