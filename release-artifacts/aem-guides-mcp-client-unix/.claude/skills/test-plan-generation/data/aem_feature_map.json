          "reference_urls": [
            "https://experienceleague.adobe.com/en/docs/experience-manager-65-lts/content/assets/using/assets-workflow",
            "https://experienceleague.adobe.com/en/docs/experience-manager-cloud-service/content/assets/assets-cloud-changes"
