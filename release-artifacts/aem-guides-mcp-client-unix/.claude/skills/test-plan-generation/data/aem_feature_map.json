          "shared_flows": [
            "asset upload",
            "asset ingestion"
          ],
          "implied_dimension_axis": "CODE_PATH_CONSUMER",
          "candidate_template": "when native duplicate detection is enabled, duplicate checking and notification still run on the shared asset upload path, including same-content files with different names",
          "reference": "Experience League detect-duplicate-assets",
          "reference_urls": [
            "https://experienceleague.adobe.com/en/docs/experience-manager-cloud-service/content/assets/admin/detect-duplicate-assets"
          ],
          "approval_status": "HUMAN_APPROVED"
        },
        {
          "feature": "versioning and timeline",
          "shared_flows": [
            "same-path asset upload",
            "asset overwrite conflict"
          ],
          "implied_dimension_axis": "LIFECYCLE",
          "candidate_template": "the selected same-path upload action leaves the documented version and timeline result, including the available rollback behavior",
          "reference": "Experience League add-assets and manage-digital-assets",
          "reference_urls": [
            "https://experienceleague.adobe.com/en/docs/experience-manager-cloud-service/content/assets/manage/add-assets",
