# UAC release automation (Linux VM). Install with: crontab -e, then paste these lines.
# Matches the live crontab on the UAC VM (10.42.46.78); on another machine adjust REPO, CONFIG
# and the Python path. Times are the VM clock (UTC); IST = UTC + 5:30.
# Copilot CLI reads COPILOT_GITHUB_TOKEN;
# keep it and the Jira settings in /opt/uac-release/uac.env (chmod 600); the scripts load it.
REPO=/root/aem-guides-dataset-studio
CONFIG=/opt/uac-release/config.json
# cron starts with PATH=/usr/bin:/bin, where neither `copilot` nor `node` (npm install -g) is found;
# without this line the runner's health check stops every night with "Copilot CLI not found on PATH".
# Use the folders `dirname $(command -v copilot)` and `dirname $(command -v node)` print in your shell
# (for nvm, e.g. /home/<user>/.nvm/versions/node/v22.x.y/bin).
PATH=/usr/local/bin:/usr/bin:/bin

# 01:30 UTC (07:00 IST) every night: generate the UACs and write each one that passes the checks into the
# Acceptance Criteria field, with the QEVision_UAC_DONE label.
30 1 * * * cd $REPO && /usr/bin/python3 scripts/uac_release/uac_release_runner.py --config $CONFIG --env-file /opt/uac-release/uac.env >> /opt/uac-release/cron.log 2>&1

# 02:00 UTC (07:30 IST) Mon-Fri: alert QE when a root cause, fix or API contract arrives after a UAC was posted (read-only on tickets).
0 2 * * 1-5 cd $REPO && /usr/bin/python3 scripts/uac_release/uac_staleness_watch.py --config $CONFIG --env-file /opt/uac-release/uac.env >> /opt/uac-release/cron.log 2>&1

# 02:30 UTC (08:00 IST) every night: learn from QE edits to posted UACs (read-only on Jira).
30 2 * * * cd $REPO && /usr/bin/python3 scripts/uac_release/uac_learning_harvester.py --config $CONFIG --env-file /opt/uac-release/uac.env >> /opt/uac-release/cron.log 2>&1

# 06:00 UTC (11:30 IST) on the 1st: monthly learning report for the previous month.
0 6 1 * * cd $REPO && /usr/bin/python3 scripts/uac_release/uac_learning_harvester.py --config $CONFIG --env-file /opt/uac-release/uac.env --report last >> /opt/uac-release/cron.log 2>&1

# Every 30 minutes: rebuild the read-only release page served at http://<vm>:4502/uac-release (never calls Jira).
*/30 * * * * cd $REPO && /usr/bin/python3 scripts/uac_release/release_dashboard.py --config $CONFIG --env-file /opt/uac-release/uac.env --out /var/www/uac-release/index.html >> /opt/uac-release/cron.log 2>&1
