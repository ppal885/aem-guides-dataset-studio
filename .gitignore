# Runtime state / logs the app rewrites every run — untracked to avoid pull conflicts
# on running hosts (VMs). Regenerated automatically; not needed in version control.
backend/storage/knowledge_source_state/
backend/storage/ai_flow_intelligence.json
backend/storage/corrective_rag_traces.jsonl
backend/storage/**/failure_log.jsonl

# Machine-specific MCP client config (local absolute paths) -- .mcp.json.example is the template.
.mcp.json
ui_evidence/auth/
ui_evidence/screenshots/
**/storage_state.json

# Local agent worktrees and interrupted benchmark candidates.
.worktrees/
analysis/golden_benchmark_runs/

# Generated test/runtime work directories (some are sandbox-owned on Windows).
backend/.pytest_tmp/
backend/.test_workdirs/
backend/ai-flow-tests-*/
backend/codex-dita-*/
backend/tests/tmp*/
backend/tmp*/

# Generated AEM export packages use UUID directory names. Curated corpus snapshots
# under backend/storage/corpus_snapshots remain intentionally versionable.
backend/storage/[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]-*/

# Local plan execution memory and downloaded customer evidence can contain large
# recordings or internal material; keep them on disk, never in source control.
output/test-plans/.pipeline-memory/
output/evidence/

# Jira-derived/private evaluation material must not be published from this
