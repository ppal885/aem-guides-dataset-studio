# ─────────────────────────────────────────────────────────────────────────────
# AEM Guides Dataset Studio — Docker Environment Template
# Copy this file to .env.docker and fill in real values.
# .env.docker is gitignored — never commit it.
# ─────────────────────────────────────────────────────────────────────────────

# ── Auth ─────────────────────────────────────────────────────────────────────
# Set to false in production and provide real tokens below
ALLOW_DEV_AUTH_BYPASS=true
# Production token (set ALLOW_DEV_AUTH_BYPASS=false and use this):
# API_BEARER_TOKEN=replace-with-a-strong-secret-token

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Choose one: anthropic | azure_openai | openai | groq | bedrock
LLM_PROVIDER=azure_openai

# Azure OpenAI (recommended for Adobe internal)
AZURE_OPENAI_API_KEY=your-azure-openai-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_MODEL=gpt-5.2
SCREENSHOT_VISION_PROVIDER=azure_openai

# Anthropic (alternative)
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (alternative)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# ── Jira Integration ─────────────────────────────────────────────────────────
JIRA_URL=https://jira.corp.adobe.com
JIRA_USERNAME=your-jira-username
JIRA_PASSWORD=your-jira-password
JIRA_API_VERSION=2
JIRA_PROJECT_KEY=GUIDES

# ── Runtime ──────────────────────────────────────────────────────────────────
ENVIRONMENT=production
PORT=8001
LOG_LEVEL=INFO
STRUCTURED_LOGGING=false

# ── Database (SQLite by default — no config needed) ──────────────────────────
# Uncomment to use PostgreSQL instead:
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Storage ──────────────────────────────────────────────────────────────────
# Path inside the container (maps to the backend_storage volume)
STORAGE_PATH=/app/storage

# ── Optional Features ────────────────────────────────────────────────────────
# QA Studio LLM authoring
# QA_STUDIO_LLM_AUTHORING=true

# Tavily web search augmentation
# TAVILY_API_KEY=tvly-...

# DITA-OT validation (requires Java in the container — disabled by default)
# DITA_BUILD_VALIDATION_ENABLED=false
